@model BilleteraDigital_Web.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - FinTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f5f7fb; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card-fintrack { border: none; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .btn-fintrack { background-color: #3b5bdb; border-color: #3b5bdb; color: white; font-weight: 500; border-radius: 6px; }
        .btn-fintrack:hover { background-color: #304bbc; color: white; }
        .text-fintrack { color: #1a1f36; font-weight: bold; }
        .form-control:focus { border-color: #3b5bdb; box-shadow: 0 0 0 0.25rem rgba(59, 91, 219, 0.25); }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center vh-100">

    <div class="card card-fintrack p-4" style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <h2 class="text-fintrack mb-1">FinTrack</h2>
            <p class="text-muted">Control financiero</p>
        </div>

        <h5 class="mb-3">Iniciar Sesión</h5>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label text-muted small mb-1">Correo electrónico</label>
                <input asp-for="Correo" class="form-control" placeholder="Ejemplo: correo@email.com" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Contrasena" class="form-label text-muted small mb-1">Contraseña</label>
                <input asp-for="Contrasena" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Contrasena" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-fintrack w-100 py-2">Ingresar a mi cuenta</button>
        </form>

        <div class="text-center mt-4">
            <span class="text-muted small">¿No tienes una cuenta?</span>
            <a href="@Url.Action("Registro", "Auth")" class="text-decoration-none small" style="color: #3b5bdb; font-weight: 500;">Regístrate aquí</a>
        </div>
    </div>

</body>
</html>