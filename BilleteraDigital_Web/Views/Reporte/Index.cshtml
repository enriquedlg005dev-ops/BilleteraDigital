@{
    ViewData["Title"] = "Reportes";
}

<style>

    .reportes-container {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* HEADER */

    .reportes-header {
        margin-bottom: 25px;
    }

        .reportes-header h1 {
            font-size: 30px;
            font-weight: 700;
            color: #1a2140;
            margin-bottom: 6px;
        }

        .reportes-header p {
            color: #7b849c;
            margin: 0;
            font-size: 15px;
        }

    /* FILTROS */

    .reportes-filtros {
        background: #ffffff;
        padding: 24px;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 18px;
        align-items: end;
        margin-bottom: 25px;
    }

    .filtro {
        display: flex;
        flex-direction: column;
    }

        .filtro label {
            font-size: 13px;
            font-weight: 600;
            color: #5f6880;
            margin-bottom: 7px;
        }

        .filtro input,
        .filtro select {
            height: 42px;
            border: 1px solid #dfe3ec;
            border-radius: 9px;
            padding: 0 12px;
            font-size: 14px;
            color: #333b52;
            background: #fff;
            outline: none;
            transition: 0.2s;
        }

            .filtro input:focus,
            .filtro select:focus {
                border-color: #3d5af1;
                box-shadow: 0 0 0 3px rgba(61, 90, 241, 0.10);
            }

    .boton-filtro {
        justify-content: flex-end;
    }

    #btnBuscar {
        height: 42px;
        border: none;
        border-radius: 9px;
        background: #3d5af1;
        color: white;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        #btnBuscar:hover {
            background: #3049d8;
            transform: translateY(-1px);
        }

        #btnBuscar:disabled {
            opacity: .6;
            cursor: not-allowed;
            transform: none;
        }

    /* BOTON LIMPIAR */

    #btnLimpiar {
        height: 42px;
        border: 1px solid #dfe3ec;
        border-radius: 9px;
        background: #fff;
        color: #59627a;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        #btnLimpiar:hover {
            background: #f4f6f9;
        }

    /* RESULTADOS */

    .reportes-resultados {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .resultados-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .resultados-header h4 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            color: #1a2140;
        }

    .contador {
        background: #eef1ff;
        color: #3d5af1;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    /* TABLA */

    .table-responsive {
        overflow-x: auto;
    }

    .table {
        margin: 0;
        width: 100%;
        border-collapse: collapse;
    }

        .table thead th {
            background: #f8f9fc;
            color: #6e768d;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .3px;
            font-weight: 700;
            padding: 14px 20px;
            border-bottom: 1px solid #edf0f5;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 16px 20px;
            border-bottom: 1px solid #f0f2f6;
            color: #454d63;
            font-size: 14px;
            vertical-align: middle;
        }

        .table tbody tr:hover {
            background: #fafbfe;
        }

    .monto {
        font-weight: 700;
        color: #1a2140;
        white-space: nowrap;
    }

    .tipo-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .tipo-ingreso {
        background: #e8f8ef;
        color: #1d8a4b;
    }

    .tipo-gasto {
        background: #fff0f0;
        color: #d64545;
    }

    .tipo-transferencia {
        background: #eef1ff;
        color: #3d5af1;
    }

    .estado-vacio {
        padding: 45px 20px !important;
        text-align: center;
        color: #9299aa !important;
    }

    .estado-vacio-icono {
        font-size: 35px;
        margin-bottom: 10px;
        display: block;
    }

    /* LOADING */

    .loading {
        padding: 40px;
        text-align: center;
        color: #7d859b;
    }

    .spinner {
        width: 25px;
        height: 25px;
        border: 3px solid #e5e8f0;
        border-top-color: #3d5af1;
        border-radius: 50%;
        animation: girar .8s linear infinite;
        margin: 0 auto 10px;
    }

    @@keyframes girar {
        to {
            transform: rotate(360deg);
        }
    }

    /* RESPONSIVE */

    @@media (max-width: 1100px) {

        .reportes-filtros {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 700px) {

        .reportes-filtros {
            grid-template-columns: 1fr;
        }

        .reportes-header h1 {
            font-size: 25px;
        }

        .resultados-header {
            padding: 16px;
        }

        .table thead th,
        .table tbody td {
            padding: 12px;
        }
    }

</style>


<div class="reportes-container">

    <!-- HEADER -->

    <div class="reportes-header">

        <h1>Reportes</h1>

        <p>
            Consulta y exporta los movimientos de tu billetera digital.
        </p>

    </div>


    <!-- FILTROS -->

    <div class="reportes-filtros">

        <div class="filtro">

            <label for="fechaInicio">
                Fecha inicio
            </label>

            <input type="date"
                   id="fechaInicio" />

        </div>


        <div class="filtro">

            <label for="fechaFin">
                Fecha fin
            </label>

            <input type="date"
                   id="fechaFin" />

        </div>


        <div class="filtro">

            <label for="tipoMovimiento">
                Tipo de movimiento
            </label>

            <select id="tipoMovimiento">

                <option value="">
                    Todos
                </option>

                <option value="1">
                    Ingreso
                </option>

                <option value="2">
                    Gasto
                </option>

                <option value="3">
                    Transferencia
                </option>

            </select>

        </div>


        <div class="filtro">

            <label for="categoria">
                Categoría
            </label>

            <select id="categoria">

                <option value="">
                    Cargando categorías...
                </option>

            </select>

        </div>


        <div class="filtro boton-filtro">

            <button type="button"
                    id="btnBuscar">

                🔍 Buscar

            </button>

        </div>

        <div class="filtro">

            <label>
                &nbsp;
            </label>

            <button type="button"
                    id="btnLimpiar">

                ↻ Limpiar filtros

            </button>

        </div>

    </div>


    <!-- RESULTADOS -->

    <div class="reportes-resultados">

        <div class="resultados-header">

            <h4>
                Movimientos encontrados
            </h4>

            <span class="contador"
                  id="contadorMovimientos">

                0 movimientos

            </span>

        </div>


        <div class="table-responsive">

            <table class="table">

                <thead>

                    <tr>

                        <th>
                            Fecha
                        </th>

                        <th>
                            Tipo
                        </th>

                        <th>
                            Categoría
                        </th>

                        <th>
                            Descripción
                        </th>

                        <th>
                            Monto
                        </th>

                    </tr>

                </thead>


                <tbody id="tablaMovimientos">

                    <tr>

                        <td colspan="5"
                            class="estado-vacio">

                            <span class="estado-vacio-icono">
                                📊
                            </span>

                            Realiza una búsqueda para mostrar
                            los movimientos.

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        const ID_USUARIO = 1;


        // ==========================================
        // CARGAR CATEGORÍAS
        // ==========================================

        async function cargarCategorias() {

            const select =
                document.getElementById("categoria");

            try {

                const response =
                    await fetch(
                        `/Reporte/Categorias?idUsuario=${ID_USUARIO}`
                    );

                if (!response.ok) {

                    throw new Error(
                        "Error HTTP: " + response.status
                    );

                }

                const categorias =
                    await response.json();


                select.innerHTML = `
                    <option value="">
                        Todas
                    </option>
                `;


                if (categorias && categorias.length > 0) {

                    categorias.forEach(categoria => {

                        select.innerHTML += `
                            <option value="${categoria.idCategoria}">
                                ${categoria.nombre}
                            </option>
                        `;

                    });

                }

            }
            catch (error) {

                console.error(
                    "Error al cargar categorías:",
                    error
                );

                select.innerHTML = `
                    <option value="">
                        No se pudieron cargar
                    </option>
                `;

            }

        }


        // ==========================================
        // BUSCAR
        // ==========================================

        document
            .getElementById("btnBuscar")
            .addEventListener("click", async function () {


                console.log("BUSCAR PRESIONADO");


                const fechaInicio =
                    document
                        .getElementById("fechaInicio")
                        .value;


                const fechaFin =
                    document
                        .getElementById("fechaFin")
                        .value;


                const tipoMovimiento =
                    document
                        .getElementById("tipoMovimiento")
                        .value;


                const categoria =
                    document
                        .getElementById("categoria")
                        .value;


                const parametros =
                    new URLSearchParams();


                parametros.append(
                    "idUsuario",
                    ID_USUARIO
                );


                if (fechaInicio) {

                    parametros.append(
                        "fechaInicio",
                        fechaInicio
                    );

                }


                if (fechaFin) {

                    parametros.append(
                        "fechaFin",
                        fechaFin
                    );

                }


                if (tipoMovimiento) {

                    parametros.append(
                        "idTipoMovimiento",
                        tipoMovimiento
                    );

                }


                if (categoria) {

                    parametros.append(
                        "idCategoria",
                        categoria
                    );

                }


                const url =
                    `/Reporte/Buscar?${parametros.toString()}`;


                console.log(
                    "URL:",
                    url
                );


                const boton =
                    document.getElementById(
                        "btnBuscar"
                    );


                boton.disabled = true;


                mostrarCargando();


                try {

                    const response =
                        await fetch(url);


                    console.log(
                        "STATUS:",
                        response.status
                    );


                    if (!response.ok) {

                        throw new Error(
                            "Error HTTP: " +
                            response.status
                        );

                    }


                    const movimientos =
                        await response.json();


                    console.log(
                        "MOVIMIENTOS:",
                        movimientos
                    );


                    mostrarMovimientos(
                        movimientos
                    );

                }
                catch (error) {

                    console.error(
                        "ERROR:",
                        error
                    );


                    mostrarError();

                }
                finally {

                    boton.disabled = false;

                }

            });


        // ==========================================
        // MOSTRAR CARGANDO
        // ==========================================

        function mostrarCargando() {

            const tabla =
                document.getElementById(
                    "tablaMovimientos"
                );


            tabla.innerHTML = `

                <tr>

                    <td
                        colspan="5"
                        class="estado-vacio">

                        <div class="loading">

                            <div class="spinner"></div>

                            Consultando movimientos...

                        </div>

                    </td>

                </tr>

            `;

        }


        // ==========================================
        // MOSTRAR ERROR
        // ==========================================

        function mostrarError() {

            const tabla =
                document.getElementById(
                    "tablaMovimientos"
                );


            tabla.innerHTML = `

                <tr>

                    <td
                        colspan="5"
                        class="estado-vacio">

                        <span class="estado-vacio-icono">
                            ⚠️
                        </span>

                        Ocurrió un error al consultar
                        los movimientos.

                    </td>

                </tr>

            `;


            actualizarContador(0);

        }


        // ==========================================
        // MOSTRAR MOVIMIENTOS
        // ==========================================

        function mostrarMovimientos(
            movimientos
        ) {

            const tabla =
                document.getElementById(
                    "tablaMovimientos"
                );


            tabla.innerHTML = "";


            actualizarContador(
                movimientos
                    ? movimientos.length
                    : 0
            );


            if (
                !movimientos ||
                movimientos.length === 0
            ) {

                tabla.innerHTML = `

                    <tr>

                        <td
                            colspan="5"
                            class="estado-vacio">

                            <span class="estado-vacio-icono">
                                🔎
                            </span>

                            No se encontraron movimientos
                            con los filtros seleccionados.

                        </td>

                    </tr>

                `;

                return;

            }


            movimientos.forEach(
                movimiento => {


                    const fecha =
                        new Date(
                            movimiento.fechaMovimiento
                        ).toLocaleDateString(
                            "es-PE"
                        );


                    let claseTipo =
                        "";


                    if (
                        movimiento.tipoMovimiento ===
                        "Ingreso"
                    ) {

                        claseTipo =
                            "tipo-ingreso";

                    }
                    else if (
                        movimiento.tipoMovimiento ===
                        "Gasto"
                    ) {

                        claseTipo =
                            "tipo-gasto";

                    }
                    else {

                        claseTipo =
                            "tipo-transferencia";

                    }


                    tabla.innerHTML += `

                        <tr>

                            <td>
                                ${fecha}
                            </td>

                            <td>

                                <span
                                    class="tipo-badge ${claseTipo}">

                                    ${movimiento.tipoMovimiento}

                                </span>

                            </td>

                            <td>
                                ${movimiento.categoria}
                            </td>

                            <td>
                                ${movimiento.descripcion ?? ""}
                            </td>

                            <td class="monto">

                                S/
                                ${Number(
                                    movimiento.monto
                                ).toFixed(2)}

                            </td>

                        </tr>

                    `;

                }
            );

        }


        // ==========================================
        // CONTADOR
        // ==========================================

        function actualizarContador(
            cantidad
        ) {

            const contador =
                document.getElementById(
                    "contadorMovimientos"
                );


            contador.textContent =
                cantidad === 1
                    ? "1 movimiento"
                    : `${cantidad} movimientos`;

        }


        // ==========================================
        // LIMPIAR FILTROS
        // ==========================================

        document
            .getElementById("btnLimpiar")
            .addEventListener(
                "click",
                function () {

                    document
                        .getElementById(
                            "fechaInicio"
                        )
                        .value = "";


                    document
                        .getElementById(
                            "fechaFin"
                        )
                        .value = "";


                    document
                        .getElementById(
                            "tipoMovimiento"
                        )
                        .value = "";


                    document
                        .getElementById(
                            "categoria"
                        )
                        .value = "";


                    document
                        .getElementById(
                            "tablaMovimientos"
                        )
                        .innerHTML = `

                        <tr>

                            <td
                                colspan="5"
                                class="estado-vacio">

                                <span class="estado-vacio-icono">
                                    📊
                                </span>

                                Realiza una búsqueda
                                para mostrar los movimientos.

                            </td>

                        </tr>

                    `;


                    actualizarContador(0);

                }
            );


        // ==========================================
        // INICIO
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                cargarCategorias();

            }
        );

    </script>

}