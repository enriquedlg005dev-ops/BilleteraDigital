﻿@model BilleteraDigital.MVC.Models.MovimientoRequest
@{
    ViewData["Title"] = "Editar Movimiento";
}

<style>
    .bd-form-card {
        border: none;
        border-radius: 14px;
        box-shadow: 0 2px 10px rgba(19, 26, 46, 0.06);
        padding: 1.75rem;
        max-width: 520px;
    }

    .bd-form-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #1a2140;
        margin-bottom: .3rem;
    }

    .bd-form-subtitle {
        color: #9099b5;
        font-size: .88rem;
        margin-bottom: 1.5rem;
    }

    .bd-form-group {
        margin-bottom: 1.1rem;
    }

        .bd-form-group label {
            font-weight: 600;
            font-size: .85rem;
            color: #4a5175;
            margin-bottom: .35rem;
            display: block;
        }

        .bd-form-group .form-control,
        .bd-form-group .form-select {
            border-radius: 8px;
            border: 1px solid #dde1ec;
            padding: .55rem .75rem;
        }

            .bd-form-group .form-control:focus,
            .bd-form-group .form-select:focus {
                border-color: #3d5af1;
                box-shadow: 0 0 0 3px rgba(61, 90, 241, .12);
            }

    .bd-btn-primary {
        background-color: #3d5af1;
        border-color: #3d5af1;
        font-weight: 500;
    }

        .bd-btn-primary:hover {
            background-color: #2f47d1;
            border-color: #2f47d1;
        }
</style>

<div class="bd-form-card bg-white">
    <div class="bd-form-title">Editar Movimiento</div>
    <div class="bd-form-subtitle">Actualiza los datos del movimiento registrado</div>

    <form asp-action="Edit" asp-route-idMovimiento="@ViewBag.IdMovimiento">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="bd-form-group">
            <label asp-for="IdUsuario"></label>
            <input asp-for="IdUsuario" class="form-control" />
            <span asp-validation-for="IdUsuario" class="text-danger"></span>
        </div>

        <div class="bd-form-group">
            <label asp-for="IdCategoria"></label>
            <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.categorias">
                <option value="">-- Seleccione una categoría --</option>
            </select>
            <span asp-validation-for="IdCategoria" class="text-danger"></span>
        </div>

        <div class="bd-form-group">
            <label asp-for="IdTipoMovimiento"></label>
            <select asp-for="IdTipoMovimiento" class="form-select">
                <option value="1">Ingreso</option>
                <option value="2">Gasto</option>
            </select>
            <span asp-validation-for="IdTipoMovimiento" class="text-danger"></span>
        </div>

        <div class="bd-form-group">
            <label asp-for="Monto"></label>
            <input asp-for="Monto" class="form-control" />
            <span asp-validation-for="Monto" class="text-danger"></span>
        </div>

        <div class="bd-form-group">
            <label asp-for="Descripcion"></label>
            <input asp-for="Descripcion" class="form-control" />
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 mt-4">
            <input type="submit" value="Guardar cambios" class="btn bd-btn-primary text-white px-4" />
            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
