<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BilleteraDigital</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BilleteraDigital.MVC.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <style>
        :root {
            --bd-bg: #f4f6f9;
            --bd-sidebar: #131a2e;
            --bd-sidebar-hover: #1c2540;
            --bd-sidebar-active: #3d5af1;
            --bd-text-muted: #9099b5;
        }

        body {
            background-color: var(--bd-bg);
            font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
        }

        .bd-shell {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .bd-sidebar {
            width: 240px;
            flex-shrink: 0;
            background-color: var(--bd-sidebar);
            color: #fff;
            display: flex;
            flex-direction: column;
            padding: 1.5rem 1rem;
        }

        .bd-brand {
            display: flex;
            align-items: center;
            gap: .6rem;
            padding: 0 .5rem 1.5rem;
            margin-bottom: .5rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .bd-brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: linear-gradient(135deg, #3d5af1, #7b8cf7);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .bd-brand-text .bd-title {
            font-weight: 700;
            font-size: 1.05rem;
            line-height: 1.1;
        }

        .bd-brand-text .bd-subtitle {
            font-size: .72rem;
            color: var(--bd-text-muted);
        }

        .bd-nav {
            list-style: none;
            padding: 0;
            margin: 1rem 0 0;
            display: flex;
            flex-direction: column;
            gap: .25rem;
        }

        .bd-nav-link {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .65rem .85rem;
            border-radius: 10px;
            color: var(--bd-text-muted);
            text-decoration: none;
            font-size: .92rem;
            font-weight: 500;
            transition: background-color .15s ease, color .15s ease;
        }

            .bd-nav-link i {
                font-size: 1.05rem;
                width: 20px;
                text-align: center;
            }

            .bd-nav-link:hover {
                background-color: var(--bd-sidebar-hover);
                color: #fff;
            }

            .bd-nav-link.active {
                background-color: var(--bd-sidebar-active);
                color: #fff;
            }

        /* Main content */
        .bd-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .bd-topbar {
            background: #fff;
            border-bottom: 1px solid #e7e9f0;
            padding: .9rem 1.75rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .bd-topbar-title {
            font-weight: 600;
            color: #1a2140;
        }

        .bd-content {
            padding: 1.75rem;
            flex: 1;
        }

        .bd-footer {
            padding: .9rem 1.75rem;
            font-size: .8rem;
            color: #9099b5;
            border-top: 1px solid #e7e9f0;
            background: #fff;
        }

        /* Mobile toggle */
        .bd-sidebar-toggle {
            display: none;
        }

        @@media (max-width: 860px) {
            .bd-shell {
                flex-direction: column;
            }

            .bd-sidebar {
                width: 100%;
                flex-direction: row;
                align-items: center;
                padding: .75rem 1rem;
            }

            .bd-brand {
                border-bottom: none;
                padding: 0;
                margin: 0;
                flex: 1;
            }

            .bd-nav {
                display: none;
            }

            .bd-sidebar-toggle {
                display: inline-flex;
                background: transparent;
                border: none;
                color: #fff;
                font-size: 1.3rem;
            }

            .bd-nav.bd-nav-open {
                display: flex;
                position: absolute;
                top: 64px;
                left: 0;
                right: 0;
                background: var(--bd-sidebar);
                padding: .75rem 1rem 1rem;
                z-index: 1030;
            }
        }
    </style>
</head>

<body>
    <div class="bd-shell">

        <aside class="bd-sidebar">

            <div class="bd-brand">
                <div class="bd-brand-icon">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div class="bd-brand-text">
                    <div class="bd-title">FinTrack</div>
                    <div class="bd-subtitle">Control financiero</div>
                </div>

                <button class="bd-sidebar-toggle ms-auto"
                        type="button"
                        onclick="document.querySelector('.bd-nav').classList.toggle('bd-nav-open')">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            @{
                var controllerName = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            }

            <ul class="bd-nav">

                <li>
                    <a class="bd-nav-link @(controllerName == "Home" ? "active" : "")"
                       asp-controller="Home"
                       asp-action="Index">
                        <i class="bi bi-grid-1x2"></i>
                        Dashboard
                    </a>
                </li>

                <li>
                    <a class="bd-nav-link @(controllerName == "Movimiento" ? "active" : "")"
                       asp-controller="Movimiento"
                       asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i>
                        Movimientos
                    </a>
                </li>

                <li>
                    <a class="bd-nav-link @(controllerName == "Categoria" ? "active" : "")"
                       asp-controller="Categoria"
                       asp-action="Index">
                        <i class="bi bi-tag"></i>
                        Categorías
                    </a>
                </li>

                <li>
                    <a class="bd-nav-link @(controllerName == "Presupuesto" ? "active" : "")"
                       asp-controller="Presupuesto"
                       asp-action="Index">
                        <i class="bi bi-piggy-bank"></i>
                        Presupuestos
                    </a>
                </li>

                <li>
                    <a class="bd-nav-link @(controllerName == "Reporte" ? "active" : "")"
                       asp-controller="Reporte"
                       asp-action="Index">
                        <i class="bi bi-bar-chart"></i>
                        Reportes
                    </a>
                </li>

                <li>
                    <a class="bd-nav-link @(controllerName == "Usuario" ? "active" : "")"
                       asp-controller="Usuario"
                       asp-action="MiPerfil">
                        <i class="bi bi-person-circle"></i>
                        Mi perfil
                    </a>
                </li>

            </ul>

        </aside>

        <div class="bd-main">

            <div class="bd-topbar">
                <span class="bd-topbar-title">
                    @ViewData["Title"]
                </span>
            </div>

            <main class="bd-content" role="main">
                @RenderBody()
            </main>

            <footer class="bd-footer">
                &copy; 2026 - FinTrack
            </footer>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>