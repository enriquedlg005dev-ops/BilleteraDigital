@model BilleteraDigital_Web.Models.PresupuestoViewModel

@{
    ViewData["Title"] = "Presupuestos";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>

    .presupuesto-container {
        padding: 10px;
    }

    .presupuesto-header {
        margin-bottom: 25px;
    }

        .presupuesto-header h2 {
            font-weight: 700;
            color: #1a2140;
            margin-bottom: 5px;
        }

        .presupuesto-header p {
            color: #9099b5;
            margin: 0;
        }

    /* TARJETAS RESUMEN */

    .resumen-card {
        background: white;
        border: none;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
        height: 100%;
    }

        .resumen-card small {
            color: #9099b5;
            font-weight: 500;
        }

        .resumen-card h3 {
            margin-top: 8px;
            margin-bottom: 0;
            font-weight: 700;
        }

    .resumen-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef1ff;
        color: #3d5af1;
        font-size: 20px;
    }

    /* FORMULARIO */

    .presupuesto-form-card {
        background: white;
        border: none;
        border-radius: 14px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
    }

        .presupuesto-form-card h5 {
            font-weight: 700;
            color: #1a2140;
            margin-bottom: 20px;
        }

    .form-label {
        font-weight: 600;
        color: #555d78;
    }

    .form-control,
    .form-select {
        border-radius: 9px;
        border: 1px solid #dfe3ec;
        padding: 10px 12px;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #3d5af1;
            box-shadow: 0 0 0 .15rem rgba(61,90,241,.12);
        }

    .btn-guardar {
        background: #3d5af1;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 10px 20px;
        font-weight: 600;
    }

        .btn-guardar:hover {
            background: #3048d1;
            color: white;
        }

    /* LISTADO */

    .listado-header {
        margin-top: 30px;
        margin-bottom: 15px;
    }

        .listado-header h5 {
            font-weight: 700;
            color: #1a2140;
            margin-bottom: 3px;
        }

    .buscar-presupuesto {
        width: 250px;
    }

    /* TARJETAS */

    .presupuesto-card {
        background: white;
        border: none;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
        height: 100%;
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .presupuesto-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 20px rgba(0,0,0,.08);
        }

    .categoria-nombre {
        font-weight: 700;
        color: #1a2140;
    }

    .monto-limite {
        font-weight: 700;
        color: #3d5af1;
        font-size: 18px;
    }

    .mes-presupuesto {
        color: #9099b5;
        font-size: 13px;
    }

    .progress {
        background-color: #edf0f5;
        border-radius: 10px;
    }

    .progress-bar {
        border-radius: 10px;
    }

    .datos-presupuesto {
        font-size: 13px;
    }

    .btn-eliminar {
        border-radius: 8px;
    }

    .sin-presupuestos {
        background: white;
        border-radius: 14px;
        padding: 40px;
        text-align: center;
        color: #9099b5;
    }

    @@media (max-width: 768px) {

        .buscar-presupuesto {
            width: 100%;
            margin-top: 10px;
        }

        .listado-header {
            flex-direction: column;
            align-items: stretch !important;
        }
    }

</style>


<div class="presupuesto-container">

    <!-- HEADER -->

    <div class="presupuesto-header">

        <h2>
            <i class="bi bi-piggy-bank"></i>
            Presupuestos
        </h2>

        <p>
            Controla cuánto planeas gastar por categoría y período.
        </p>

    </div>


    <!-- ========================= -->
    <!-- TARJETAS DE RESUMEN -->
    <!-- ========================= -->

    <div class="row g-3 mb-4">

        <!-- TOTAL PRESUPUESTADO -->

        <div class="col-md-4">

            <div class="resumen-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <small>
                            Total presupuestado
                        </small>

                        <h3>
                            S/
                            @Model.TotalPresupuestado.ToString("N2")
                        </h3>

                    </div>

                    <div class="resumen-icon">
                        <i class="bi bi-wallet2"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- TOTAL GASTADO -->

        <div class="col-md-4">

            <div class="resumen-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <small>
                            Total gastado
                        </small>

                        <h3 class="text-danger">
                            S/
                            @Model.TotalGastado.ToString("N2")
                        </h3>

                    </div>

                    <div class="resumen-icon">
                        <i class="bi bi-credit-card"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- DISPONIBLE -->

        <div class="col-md-4">

            <div class="resumen-card">

                <div class="d-flex justify-content-between align-items-center">

                    <div>

                        <small>
                            Disponible
                        </small>

                        <h3 class="text-success">
                            S/
                            @Model.Disponible.ToString("N2")
                        </h3>

                    </div>

                    <div class="resumen-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- NUEVO PRESUPUESTO -->
    <!-- ========================= -->

    <div class="presupuesto-form-card mb-4">

        <h5>
            <i class="bi bi-plus-circle"></i>
            Nuevo presupuesto
        </h5>


        <div class="row g-3">

            <!-- CATEGORIA -->

            <div class="col-md-4">

                <label class="form-label">
                    Categoría
                </label>

                <select class="form-select"
                        id="cbCategoria">

                    <option value="">
                        Selecciona una categoría
                    </option>

                    @if (Model.ListaCategorias != null)
                    {
                        foreach (var cat in Model.ListaCategorias)
                        {
                            <option value="@cat.IdCategoria">
                                @cat.Nombre
                            </option>
                        }
                    }

                </select>

            </div>


            <!-- MONTO LIMITE -->

            <div class="col-md-4">

                <label class="form-label">
                    Monto límite
                </label>

                <input type="number"
                       step="0.01"
                       min="0.01"
                       class="form-control"
                       id="txtMonto"
                       placeholder="Ejemplo: 500.00" />

            </div>


            <!-- MONTO GASTADO -->

            <div class="col-md-4">

                <label class="form-label">
                    Monto gastado
                </label>

                <input type="number"
                       step="0.01"
                       min="0"
                       class="form-control"
                       id="txtMontoGastado"
                       placeholder="Ejemplo: 100.00"
                       value="0" />

            </div>


            <!-- FECHA INICIO -->

            <div class="col-md-4">

                <label class="form-label">
                    Fecha de inicio
                </label>

                <input type="date"
                       class="form-control"
                       id="txtFechaInicio" />

            </div>


            <!-- FECHA FIN -->

            <div class="col-md-4">

                <label class="form-label">
                    Fecha de fin
                </label>

                <input type="date"
                       class="form-control"
                       id="txtFechaFin" />

            </div>


            <!-- BOTON -->

            <div class="col-md-4 d-flex align-items-end">

                <button type="button"
                        class="btn btn-guardar"
                        onclick="guardarPresupuesto()">

                    <i class="bi bi-save"></i>
                    Guardar presupuesto

                </button>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- LISTADO -->
    <!-- ========================= -->

    <div class="listado-header d-flex justify-content-between align-items-center">

        <div>

            <h5>
                Listado de presupuestos
            </h5>

            <small class="text-muted">

                Total registrados:
                @(Model.ListaPresupuestos?.Count ?? 0)

            </small>

        </div>


        <div class="buscar-presupuesto">

            <input type="text"
                   id="txtBuscar"
                   class="form-control"
                   placeholder="Buscar por categoría..."
                   onkeyup="filtrarTarjetas()" />

        </div>

    </div>


    <!-- ========================= -->
    <!-- CARDS -->
    <!-- ========================= -->

    <div class="row g-3"
         id="contenedorTarjetas">

        @if (Model.ListaPresupuestos != null &&
                Model.ListaPresupuestos.Any())
        {

            foreach (var item in Model.ListaPresupuestos)
            {

                <div class="col-md-6 col-lg-4 tarjeta-item"
                     data-categoria="@(item.NombreCategoria?.ToLower() ?? "")">

                    <div class="presupuesto-card">

                        <!-- CATEGORIA Y LIMITE -->

                        <div class="d-flex justify-content-between align-items-center">

                            <span class="categoria-nombre">
                                @item.NombreCategoria
                            </span>

                            <span class="monto-limite">
                                S/
                                @item.MontoLimite.ToString("N2")
                            </span>

                        </div>


                        <!-- FECHAS -->

                        <div class="mes-presupuesto mt-1 mb-3">

                            <i class="bi bi-calendar3"></i>

                            @item.FechaInicio.ToString("dd/MM/yyyy")
                            -
                            @item.FechaFin.ToString("dd/MM/yyyy")

                        </div>


                        <!-- PROGRESO -->

                        <div class="progress mb-2"
                             style="height: 8px;">

                            <div class="progress-bar bg-primary"
                                 role="progressbar"
                                 style="width: @Math.Min(item.PorcentajeUtilizado, 100)%">
                            </div>

                        </div>


                        <!-- DATOS -->

                        <div class="d-flex justify-content-between datos-presupuesto text-muted">

                            <!-- GASTADO -->

                            <span>

                                Gastado:

                                <strong class="text-danger">

                                    S/
                                    @item.MontoGastado.ToString("N2")

                                </strong>

                            </span>


                            <!-- DISPONIBLE -->

                            <span>

                                Disponible:

                                <strong class="text-success">

                                    S/
                                    @item.Disponible.ToString("N2")

                                </strong>

                            </span>

                        </div>


                        <!-- PORCENTAJE -->

                        <div class="mt-2">

                            <small class="text-muted">

                                @item.PorcentajeUtilizado.ToString("F1")%
                                utilizado

                            </small>

                        </div>


                        <!-- BOTON ELIMINAR -->

                        <div class="text-end mt-3">

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger btn-eliminar"
                                    onclick="eliminarPresupuesto(@item.IdPresupuesto)">

                                <i class="bi bi-trash"></i>
                                Eliminar

                            </button>

                        </div>

                    </div>

                </div>

            }

        }
        else
        {

            <div class="col-12">

                <div class="sin-presupuestos">

                    <i class="bi bi-piggy-bank"
                       style="font-size:35px;">
                    </i>

                    <p class="mt-3 mb-0">
                        No se encontraron presupuestos registrados.
                    </p>

                </div>

            </div>

        }

    </div>

</div>


@section Scripts {

    <script>

        // =========================================================
        // GUARDAR PRESUPUESTO
        // =========================================================

        async function guardarPresupuesto() {

            const idCategoria =
                document.getElementById("cbCategoria").value;

            const montoLimite =
                document.getElementById("txtMonto").value;

            const montoGastado =
                document.getElementById("txtMontoGastado").value;

            const fechaInicio =
                document.getElementById("txtFechaInicio").value;

            const fechaFin =
                document.getElementById("txtFechaFin").value;


            // =========================
            // VALIDAR CATEGORIA
            // =========================

            if (!idCategoria) {

                Swal.fire(
                    "Atención",
                    "Selecciona una categoría.",
                    "warning"
                );

                return;
            }


            // =========================
            // VALIDAR MONTO LIMITE
            // =========================

            if (!montoLimite ||
                parseFloat(montoLimite) <= 0) {

                Swal.fire(
                    "Atención",
                    "Ingresa un monto límite válido mayor a 0.",
                    "warning"
                );

                return;
            }


            // =========================
            // VALIDAR MONTO GASTADO
            // =========================

            if (montoGastado === "" ||
                parseFloat(montoGastado) < 0) {

                Swal.fire(
                    "Atención",
                    "Ingresa un monto gastado válido.",
                    "warning"
                );

                return;
            }


            // =========================
            // GASTADO NO PUEDE SUPERAR LIMITE
            // =========================

            if (parseFloat(montoGastado) >
                parseFloat(montoLimite)) {

                Swal.fire(
                    "Atención",
                    "El monto gastado no puede ser mayor que el monto límite.",
                    "warning"
                );

                return;
            }


            // =========================
            // VALIDAR FECHA INICIO
            // =========================

            if (!fechaInicio) {

                Swal.fire(
                    "Atención",
                    "Selecciona la fecha de inicio.",
                    "warning"
                );

                return;
            }


            // =========================
            // VALIDAR FECHA FIN
            // =========================

            if (!fechaFin) {

                Swal.fire(
                    "Atención",
                    "Selecciona la fecha de fin.",
                    "warning"
                );

                return;
            }


            // =========================
            // VALIDAR FECHAS
            // =========================

            if (fechaFin < fechaInicio) {

                Swal.fire(
                    "Atención",
                    "La fecha de fin no puede ser menor que la fecha de inicio.",
                    "warning"
                );

                return;
            }


            // =====================================================
            // OBJETO PARA LA API
            // =====================================================

            const nuevoPresupuesto = {

                idUsuario: 1,

                idCategoria: parseInt(idCategoria),

                montoLimite: parseFloat(montoLimite),

                montoGastado: parseFloat(montoGastado),

                fechaInicio: fechaInicio,

                fechaFin: fechaFin

            };


            console.log(
                "DATOS ENVIADOS:",
                nuevoPresupuesto
            );


            // =====================================================
            // ENVIAR A LA WEB
            // =====================================================

            try {

                const response = await fetch(
                    "/Presupuesto/Registrar",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify(
                            nuevoPresupuesto
                        )
                    }
                );


                const resultado =
                    await response.json();


                console.log(
                    "RESPUESTA:",
                    resultado
                );


                if (resultado.success) {

                    await Swal.fire({

                        title: "¡Registrado!",

                        text:
                            "El presupuesto se registró correctamente.",

                        icon: "success",

                        confirmButtonText: "Aceptar"

                    });

                    window.location.reload();

                }
                else {

                    Swal.fire({

                        title: "Error",

                        text:
                            resultado.message ||
                            "No se pudo registrar el presupuesto.",

                        icon: "error"

                    });

                    console.error(
                        resultado.detalle
                    );

                }

            }
            catch (error) {

                console.error(
                    "ERROR:",
                    error
                );

                Swal.fire(
                    "Error",
                    "No se pudo conectar con la aplicación.",
                    "error"
                );

            }

        }


        // =========================================================
        // ELIMINAR PRESUPUESTO
        // =========================================================

        async function eliminarPresupuesto(id) {

            const confirmacion =
                await Swal.fire({

                    title:
                        "¿Deseas eliminar este presupuesto?",

                    text:
                        "Se realizará una eliminación lógica.",

                    icon:
                        "warning",

                    showCancelButton:
                        true,

                    confirmButtonColor:
                        "#d33",

                    cancelButtonColor:
                        "#3085d6",

                    confirmButtonText:
                        "Sí, eliminar",

                    cancelButtonText:
                        "Cancelar"

                });


            if (!confirmacion.isConfirmed) {
                return;
            }


            try {

                const response =
                    await fetch(
                        `/Presupuesto/Eliminar?id=${id}`,
                        {
                            method: "DELETE"
                        }
                    );


                const resultado =
                    await response.json();


                if (resultado.success) {

                    await Swal.fire({

                        title:
                            "Eliminado",

                        text:
                            "El presupuesto fue desactivado correctamente.",

                        icon:
                            "success",

                        confirmButtonText:
                            "Aceptar"

                    });

                    window.location.reload();

                }
                else {

                    Swal.fire(
                        "Error",
                        resultado.message ||
                        "No se pudo eliminar.",
                        "error"
                    );

                }

            }
            catch (error) {

                console.error(error);

                Swal.fire(
                    "Error",
                    "No se pudo conectar con la aplicación.",
                    "error"
                );

            }

        }


        // =========================================================
        // BUSCAR POR CATEGORIA
        // =========================================================

        function filtrarTarjetas() {

            const filtro =
                document
                    .getElementById("txtBuscar")
                    .value
                    .toLowerCase()
                    .trim();


            const tarjetas =
                document.querySelectorAll(
                    ".tarjeta-item"
                );


            tarjetas.forEach(
                tarjeta => {

                    const categoria =
                        tarjeta.getAttribute(
                            "data-categoria"
                        );


                    if (
                        categoria.includes(filtro)
                    ) {

                        tarjeta.style.display = "";

                    }
                    else {

                        tarjeta.style.display = "none";

                    }

                }
            );

        }

    </script>

}