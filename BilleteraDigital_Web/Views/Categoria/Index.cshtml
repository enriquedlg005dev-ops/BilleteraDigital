@model IEnumerable<BilleteraDigital_Web.Models.CategoriaResponse>
@{
    ViewData["Title"] = "Categorías";
}

<div class="container-fluid py-4" style="background-color: #f4f6f9; min-height: 100vh;">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">Categorías</h2>
                <p class="text-muted mb-0">Administra las categorías de tus movimientos</p>
            </div>
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm">
                <i class="bi bi-plus-circle"></i> Nueva Categoría
            </a>
        </div>

        @if (TempData["message"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                @TempData["message"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-4">Nombre</th>
                                <th>Descripción</th>
                                <th>Fecha de registro</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        <i class="bi bi-tag-fill text-primary me-2"></i>@item.Nombre
                                    </td>
                                    <td class="text-muted">@item.Descripcion</td>
                                    <td>@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @if (item.Estado)
                                        {
                                            <span class="badge rounded-pill bg-success px-3 py-2">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary px-3 py-2">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Edit" asp-route-idCategoria="@item.IdCategoria"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-idCategoria="@item.IdCategoria"
                                           class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                           onclick="return confirm('¿Seguro que deseas eliminar la categoría &quot;@item.Nombre&quot;?');">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox display-4 d-block mb-2"></i>
                        No hay categorías registradas todavía.
                    </div>
                }
            </div>
        </div>

    </div>
</div>