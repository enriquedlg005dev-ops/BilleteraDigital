@model IEnumerable<BilleteraDigital_Web.Models.CategoriaResponse>
@{
    ViewData["Title"] = "Categorías";
}

<style>
    .bd-page-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a2140;
        margin-bottom: .2rem;
    }

    .bd-page-subtitle {
        color: #9099b5;
        font-size: .92rem;
        margin-bottom: 1.5rem;
    }

    .bd-card {
        border: none;
        border-radius: 14px;
        box-shadow: 0 2px 10px rgba(19,26,46,.06);
    }

    .bd-form-group {
        margin-bottom: 1.1rem;
    }

        .bd-form-group label {
            font-weight: 600;
            font-size: .85rem;
            color: #4a5175;
            margin-bottom: .35rem;
            display: block;
        }

        .bd-form-group .form-control, .bd-form-group textarea {
            border-radius: 8px;
            border: 1px solid #dde1ec;
            padding: .55rem .75rem;
        }

            .bd-form-group .form-control:focus, .bd-form-group textarea:focus {
                border-color: #3d5af1;
                box-shadow: 0 0 0 3px rgba(61,90,241,.12);
            }

    .bd-btn-primary {
        background-color: #3d5af1;
        border-color: #3d5af1;
        font-weight: 500;
    }

        .bd-btn-primary:hover {
            background-color: #2f47d1;
            border-color: #2f47d1;
            color: #fff;
        }

    .bd-search-input {
        border-radius: 8px;
        border: 1px solid #dde1ec;
        padding: .5rem .8rem;
        font-size: .88rem;
    }

    .bd-cat-card {
        border: 1px solid #eef0f6;
        border-radius: 12px;
        padding: 1rem 1.1rem;
        height: 100%;
    }

    .bd-cat-name {
        font-weight: 700;
        color: #1a2140;
        font-size: 1rem;
        margin-bottom: .3rem;
    }

    .bd-cat-desc {
        color: #6b7290;
        font-size: .85rem;
        margin-bottom: .8rem;
        min-height: 2.4em;
    }

    .bd-badge-activo {
        background-color: #e4f7ec;
        color: #1a9d5c;
    }

    .bd-badge-inactivo {
        background-color: #eceef3;
        color: #6b7290;
    }
</style>

<div class="bd-page-title">Categorías</div>
<div class="bd-page-subtitle">Organiza tus movimientos mediante categorías personalizadas.</div>

@if (TempData["message"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- FORMULARIO: Nueva categoría -->
<div class="card bd-card mb-4">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3" style="color:#1a2140;">Nueva categoría</h5>

        <form asp-controller="Categoria" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" name="IdUsuario" value="1" />

            <div class="row">
                <div class="col-md-12 bd-form-group">
                    <label>Nombre de categoría</label>
                    <input name="Nombre" class="form-control" placeholder="Ejemplo: Alimentación" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 bd-form-group">
                    <label>Descripción</label>
                    <textarea name="Descripcion" class="form-control" rows="2" placeholder="Descripción opcional de la categoría"></textarea>
                </div>
            </div>

            <button type="submit" class="btn bd-btn-primary text-white px-4 mt-2">
                <i class="bi bi-plus-lg"></i> Guardar categoría
            </button>
        </form>
    </div>
</div>

<!-- LISTADO: Categorías -->
<div class="card bd-card">
    <div class="card-body p-4 pb-0">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-0" style="color:#1a2140;">Listado de categorías</h5>
                <small class="text-muted">Total registradas: @Model.Count()</small>
            </div>
            <input type="text" id="bdBuscarCategoria" class="bd-search-input" style="width:280px;"
                   placeholder="Buscar categoría..." />
        </div>
    </div>

    <div class="card-body pt-2">
        <div class="row g-3" id="bdListaCategorias">
            @foreach (var item in Model)
            {
                <div class="col-md-3 bd-cat-item">
                    <div class="bd-cat-card">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="bd-cat-name">@item.Nombre</div>
                            @if (item.Estado)
                            {
                                <span class="badge rounded-pill bd-badge-activo">Activo</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bd-badge-inactivo">Inactivo</span>
                            }
                        </div>
                        <div class="bd-cat-desc">@item.Descripcion</div>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-idCategoria="@item.IdCategoria"
                               class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-idCategoria="@item.IdCategoria"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('¿Seguro que deseas eliminar la categoría &quot;@item.Nombre&quot;?');">Eliminar</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox display-4 d-block mb-2"></i>
                No hay categorías registradas todavía.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('bdBuscarCategoria').addEventListener('input', function () {
            const filtro = this.value.toLowerCase();
            document.querySelectorAll('.bd-cat-item').forEach(function (item) {
                const texto = item.textContent.toLowerCase();
                item.style.display = texto.includes(filtro) ? '' : 'none';
            });
        });
    </script>
}