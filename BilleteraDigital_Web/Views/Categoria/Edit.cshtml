@model BilleteraDigital.MVC.Models.CategoriaRequest
@{
    ViewData["Title"] = "Editar Categoría";
}

<style>
    .bd-btn-primary {
        background-color: #3d5af1;
        border-color: #3d5af1;
        font-weight: 500;
    }

        .bd-btn-primary:hover {
            background-color: #2f47d1;
            border-color: #2f47d1;
            color: #fff;
        }

    .bd-form-control:focus {
        border-color: #3d5af1;
        box-shadow: 0 0 0 3px rgba(61, 90, 241, .12);
    }
</style>

<div class="mb-4">
    <h2 class="fw-bold mb-1" style="color:#1a2140;">Editar Categoría</h2>
    <p class="text-muted mb-0">Actualiza los datos de la categoría</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm" style="border-radius:14px;">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-idCategoria="@ViewBag.IdCategoria">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="IdUsuario" class="form-label fw-semibold"></label>
                        <input asp-for="IdUsuario" class="form-control bd-form-control" />
                        <span asp-validation-for="IdUsuario" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control bd-form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                        <textarea asp-for="Descripcion" class="form-control bd-form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left"></i> Cancelar
                        </a>
                        <button type="submit" class="btn bd-btn-primary text-white rounded-pill px-4">
                            <i class="bi bi-check-circle"></i> Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}