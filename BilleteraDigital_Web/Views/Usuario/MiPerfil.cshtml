@model BilleteraDigital_Web.Models.PerfilViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (TempData["MensajeExito"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["MensajeExito"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["MensajeError"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["MensajeError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0" style="border-radius: 12px;">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h4 class="mb-0" style="color: #1a1f36; font-weight: bold;">Configuración de Perfil</h4>
                    <p class="text-muted small">Actualiza tu información personal</p>
                </div>
                <div class="card-body p-4">

                    <form asp-action="MiPerfil" method="post">
                        <!-- Ocultamos el ID porque el usuario no debe editarlo visualmente -->
                        <input type="hidden" asp-for="IdUsuario" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nombre" class="form-label text-muted small fw-bold">Nombre</label>
                                <input asp-for="Nombre" class="form-control" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Apellido" class="form-label text-muted small fw-bold">Apellido</label>
                                <input asp-for="Apellido" class="form-control" />
                                <span asp-validation-for="Apellido" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label text-muted small fw-bold">Correo electrónico</label>
                                <input asp-for="Correo" class="form-control" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="Telefono" class="form-label text-muted small fw-bold">Teléfono (Opcional)</label>
                                <input asp-for="Telefono" class="form-control" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn text-white px-4 py-2" style="background-color: #3b5bdb; border-radius: 6px;">
                                Guardar cambios
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>